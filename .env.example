# Copy to .env and fill in. No real secrets are in this file.
DATABASE_URL=sqlite:///./roadsense.db
# For PostgreSQL: postgresql+psycopg2://roadsense:roadsense@localhost:5432/roadsense
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:8000
GRID_SIZE_DEG=0.05
MIN_HOTSPOT_COUNT=10
HOTSPOT_WEIGHT_FREQUENCY=0.6
HOTSPOT_WEIGHT_SEVERITY=0.4
